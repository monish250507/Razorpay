{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UCP Request Payload",
  "type": "object",
  "required": ["protocol", "agent", "merchant", "cart", "payment_auth"],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "UCP"
    },
    "agent": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "merchant": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cart": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "item_name", "price", "count"],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "item_name": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "payment_auth": {
      "type": "object",
      "required": ["limit", "expiry", "signature"],
      "properties": {
        "limit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "expiry": {
          "type": "string",
          "format": "date-time"
        },
        "signature": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
